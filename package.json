    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.10",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.42.1"
  }
}
